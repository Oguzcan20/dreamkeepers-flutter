  "monFlamehorn": "Flamehorn",
  "monFlamehornLore": "Charges lava lakes head-on without slowing.",
  "monScorchling": "Scorchling",
  "monScorchlingLore": "Small, quick, and always a little too close to catching fire.",
  "monEmbermaw": "Embermaw",
  "monEmbermawLore": "Its bite carries the heat of a coal that never quite cools.",
  "monBlazetail": "Blazetail",
