  "monGloomfang": "Gloomfang",
  "monGloomfangLore": "A last echo of the dream this ruined city used to be.",
  "monCinderfang": "Cinderfang",
  "monCinderfangLore": "Prowls the ash fields, jaws glowing faintly with banked heat.",
  "monAshclaw": "Ashclaw",
