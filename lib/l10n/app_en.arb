  "monBrookling": "Brookling",
  "monBrooklingLore": "A trickle of a creature that pools into something larger when threatened.",
  "monFrostgill": "Frostgill",
  "monFrostgillLore": "Gills that chill the water for a body length in every direction.",
  "monStormfin": "Stormfin",
