  "monCharhound": "Charhound",
  "monCharhoundLore": "Hunts in the choking ash clouds by scent alone.",
  "monPyrewing": "Pyrewing",
  "monPyrewingLore": "Circles the burning ruins on wings of drifting ember.",
  "monInferclaw": "Inferclaw",
  "monInferclawLore": "Claws still hot from the lava lake it just crawled out of.",
  "monCoalback": "Coalback",
