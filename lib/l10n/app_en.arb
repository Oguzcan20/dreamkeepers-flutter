  "dk_world_tree_warden_pass": "Ancient Roots",
  "dk_world_tree_warden_passDesc": "Reaches deeper than any dream has ever needed.",
  "dk_celestial_dragon_name": "Celestial Dragon",
  "dk_celestial_dragon_flavor": "The last dream every dreamer has, if they dream long enough.",
  "dk_celestial_dragon_ult": "Starfire Cataclysm",
  "dk_celestial_dragon_ultDesc": "Breathes out the light of a dying galaxy.",
  "dk_celestial_dragon_skill": "Comet Bite",
  "dk_celestial_dragon_skillDesc": "A bite that still carries the heat of falling through the sky.",
  "dk_celestial_dragon_pass": "Living Constellation",
  "dk_celestial_dragon_passDesc": "Made of the same stuff as the stars it flies among.",
  "dk_eclipse_empress_name": "Eclipse Empress",
  "dk_eclipse_empress_flavor": "Rules the space between one dream ending and the next beginning.",
  "dk_eclipse_empress_ult": "Total Eclipse",
  "dk_eclipse_empress_ultDesc": "Blots out every light at once, leaving the enemy nowhere to hide.",
  "dk_eclipse_empress_skill": "Crescent Edict",
  "dk_eclipse_empress_skillDesc": "A single, absolute command carved in moonlight.",
  "dk_eclipse_empress_pass": "Sovereign of Shadow",
  "dk_eclipse_empress_passDesc": "Every dark corner of the dream answers to her.",
  "dk_igo_name": "Igo",
  "dk_igo_flavor": "Not a creature of the dream at all — Igo is one of only two humans who ever stayed in Dream Haven for good, an outsider who chose to become its shield. The Dreamkeepers call him Dreamwalker, never one of their own, and he wouldn't have it any other way.",
  "dk_igo_ult": "Flutwand",
  "dk_igo_ultDesc": "Raises a protective wall of water around the whole team.",
  "dk_igo_skill": "Strömungsriss",
  "dk_igo_skillDesc": "A tearing current that damages and slows the enemy.",
  "dk_igo_pass": "Gezeitenwache",
  "dk_igo_passDesc": "Once per battle, refuses to fall and surges back at 30% HP.",
  "dk_ames_name": "Ames",
  "dk_ames_flavor": "Ames walked into Dream Haven once and simply never left — the second of the two humans who made this place home for good. No creature of dream burns quite like she does; the fire is entirely, stubbornly hers.",
  "dk_ames_ult": "Glutschnitt",
  "dk_ames_ultDesc": "A single devastating cut of white-hot flame.",
  "dk_ames_skill": "Aschesturm",
  "dk_ames_skillDesc": "A burning strike that keeps the enemy smoldering.",
  "dk_ames_pass": "Feuertaufe",
  "dk_ames_passDesc": "Hits harder the closer she comes to falling — up to +60% attack near death.",
  "dk_olf_name": "Olf",
  "dk_olf_ember_flavor": "Every save starts with an Olf. Nobody's quite sure why he insists on the tunic.",
  "dk_olf_ember_ult": "Wobbly Flame Lunge",
  "dk_olf_ember_ultDesc": "Charges in swinging his twig sword, somehow catching fire on the way.",
  "dk_olf_ember_skill": "Hot-Headed Jab",
  "dk_olf_ember_skillDesc": "A jab thrown with more enthusiasm than technique.",
  "dk_olf_pass": "Too Dumb to Be Scared",
  "dk_olf_passDesc": "Doesn't know enough to flinch.",
  "dk_olf_tide_flavor": "Chose Tide because puddles seemed friendlier than the alternative.",
  "dk_olf_tide_ult": "Bellyflop Splash",
  "dk_olf_tide_ultDesc": "Cannonballs in, mostly to see what happens.",
  "dk_olf_tide_skill": "Puddle Poke",
  "dk_olf_tide_skillDesc": "Pokes the nearest foe with his twig sword, dripping.",
  "dk_olf_bloom_flavor": "His sword and his element are, technically, the same plant.",
  "dk_olf_bloom_ult": "Overgrown Tantrum",
  "dk_olf_bloom_ultDesc": "Flails wildly through the underbrush he mostly grew himself.",
  "dk_olf_bloom_skill": "Twig Sword Thwack",
  "dk_olf_bloom_skillDesc": "A thwack from the twig sword — which is, appropriately, also a twig.",
  "dk_olf_lunar_flavor": "Picked Lunar because he liked staying up. He is always tired.",
  "dk_olf_lunar_ult": "Moonstruck Stumble",
  "dk_olf_lunar_ultDesc": "Trips over his own feet directly into the enemy, somehow on purpose.",
  "dk_olf_lunar_skill": "Sleepy Swipe",
  "dk_olf_lunar_skillDesc": "A swipe thrown half-asleep, which is most of the time.",
  "dk_olf_astral_flavor": "Believes the stars picked him. The stars have not commented.",
  "dk_olf_astral_ult": "Starry-Eyed Charge",
  "dk_olf_astral_ultDesc": "Charges in staring at the sky instead of the enemy.",
  "dk_olf_astral_skill": "Lucky Jab",
  "dk_olf_astral_skillDesc": "A jab he definitely meant to land.",
  "dk_olf_ultimate_flavor": "The other Olf isn't sure how this happened either.",
  "dk_olf_ultimate_ult": "Unlikely Hero's Flame Lunge",
  "dk_olf_ultimate_ultDesc": "The same wobbly lunge — somehow, this time, it actually connects.",
  "dk_olf_ultimate_skill": "Suspiciously Competent Jab",
  "dk_olf_ultimate_skillDesc": "A jab that lands exactly where he meant it to. He looks as surprised as you.",
  "dk_olf_ultimate_pass": "Secretly Built Different",
  "dk_olf_ultimate_passDesc": "Somehow, against all odds, this Olf turned out unfairly strong.",
